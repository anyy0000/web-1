# 공공데이터포털에서 발급받은 값으로 채운 뒤 파일명을 .env 로 복사해서 사용하세요.
# 이 파일(.env.example)은 커밋해도 되지만, 실제 값이 든 .env 파일은 절대 커밋하지 마세요.

# 공공데이터포털 "건축물대장정보 서비스" 인증키 (Decoding 된 키를 권장)
BUILDING_REGISTRY_API_KEY=

# 오퍼레이션 엔드포인트 (예: 전유부공용면적 조회)
# https://apis.data.go.kr/1613000/BldRgstService_v2/getBrExposPubuseAreaInfo
BUILDING_REGISTRY_API_ENDPOINT=
